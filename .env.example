# Where form submissions are stored. These values are on the Supabase project's
# API settings page. Copy this file to .env.local to run the site locally.
SUPABASE_URL=

# Used by the public forms. Can insert rows and nothing else.
SUPABASE_PUBLISHABLE_KEY=

# Used only by the admin panel, which is the only thing that reads submissions
# back. Never expose this one to the browser.
SUPABASE_SECRET_KEY=

# Unlocks /admin, and the key its session cookie is signed with.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
